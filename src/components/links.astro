---
import Github from "../assets/icons/github-mark.svg";
import Discord from "../assets/icons/discord.svg";
import LastFM from "../assets/icons/lastfm.svg";
import LinkedIn from "../assets/icons/linkedin.svg";
import Bluesky from "../assets/icons/bluesky.svg";
import Tangled from "../assets/icons/tangled.svg";
import { Mail } from "@lucide/astro";

const { className } = Astro.props;
---

<div class={`surface ${className} flex flex-col`}>
  <h2 class="text-2xl mb-2 text-center">Where I'm at</h2>
  <div class="flex gap-3 h-16 items-center justify-center flex-wrap px-4">
    <a
      href="https://bsky.app/profile/dustycode.dev"
      aria-label="Bluesky"
      title="Bluesky"
      target="_blank"
    >
      <Bluesky class="h-4 fill-blue" />
    </a>
    <a
      href="https://tangled.org/dustycode.dev"
      aria-label="Tangled"
      title="Tangled"
      target="_blank"
    >
      <Tangled class="h-4 fill-blue" /></a
    >
    <a
      href="https://github.com/DustinsCode"
      aria-label="Github"
      title="Github"
      target="_blank"
    >
      <Github class="h-4 fill-blue" />
    </a>
    <a
      href="https://discordapp.com/users/195312689839341569"
      aria-label="Discord"
      title="Discord"
      target="_blank"
    >
      <Discord class="h-4 w-fit fill-blue" />
    </a>
    <a
      href="https://www.last.fm/user/dustycode"
      aria-label="last.fm"
      title="Last.FM"
      target="_blank"
    >
      <LastFM class="h-4 w-fit fill-blue" />
    </a>
    <a
      href="https://www.linkedin.com/in/dustycode/"
      aria-label="LinkedIn"
      title="LinkedIn"
      target="_blank"
    >
      <LinkedIn class="h-4 w-fit fill-blue" />
    </a>
    <a href="mailto:dustin@dustycode.dev" title="Email" aria-label="email">
      <Mail class="h-4 w-fit text-blue" />
    </a>
  </div>
</div>
