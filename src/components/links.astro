---
import Github from "../assets/icons/github-mark.svg";
import Discord from "../assets/icons/discord.svg";
import LastFM from "../assets/icons/lastfm.svg";
import LinkedIn from "../assets/icons/linkedin.svg";
import Bluesky from "../assets/icons/bluesky.svg";
import { Mail } from "@lucide/astro";

const { className } = Astro.props;
---

<div class={`surface ${className}`}>
  <h1 class="text-2xl">Where to find me</h1>
  <div class="flex gap-3 h-8 items-center">
    <a
      href="https://bsky.app/profile/dustycode.dev"
      aria-label="Bluesky"
      target="_blank"
    >
      <Bluesky class="h-4 fill-blue" />
    </a>
    <a
      href="https://github.com/DustinsCode"
      aria-label="Github"
      target="_blank"
    >
      <Github class="h-4 fill-blue" />
    </a>
    <a
      href="https://discordapp.com/users/195312689839341569"
      aria-label="Discord"
      target="_blank"
    >
      <Discord class="h-4 w-fit fill-blue" />
    </a>
    <a
      href="https://www.last.fm/user/dustycode"
      aria-label="last.fm"
      target="_blank"
    >
      <LastFM class="h-4 w-fit fill-blue" />
    </a>
    <a
      href="https://www.linkedin.com/in/dustycode/"
      aria-label="LinkedIn"
      target="_blank"
    >
      <LinkedIn class="h-4 w-fit fill-blue" />
    </a>
    <a href="mailto:dustin@dustycode.dev" aria-label="email">
      <Mail class="h-4 w-fit text-blue" />
    </a>
  </div>
</div>
