---
import { Image } from "astro:assets";
import me from "../assets/me.jpeg";
---

<div class="border border-solid rounded-lg p-6">
    <div class="flex flex-col md:flex-row gap-6 items-center md:items-start">
        <div class="flex-1 space-y-4">
            <h1 class="text-5xl font-bold">Hi, I'm Dustin!</h1>
            <p class="text-lg">
                I'm a full stack software engineer from Michigan!
            </p>
            <p>
                You can often find me on the computer, out in nature, on the
                tennis courts, or wherever there will be some cool cars, and almost always with my camera :)
            </p>
        </div>
        <Image
            class="rounded-full size-40 md:size-48 flex-shrink-0"
            loading="eager"
            src={me}
            alt="Me smiling in my snowboarding jacket on a sunny winter day"
        />
    </div>
</div>
