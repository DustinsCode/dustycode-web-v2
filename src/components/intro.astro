---
import Github from '../assets/icons/github-mark.svg'
import Discord from '../assets/icons/discord.svg'
import LastFM from '../assets/icons/lastfm.svg'
import LinkedIn from '../assets/icons/linkedin.svg'
---

<div class="border-1 border-solid rounded-lg w-md p-4">
    <h1 class="text-5xl font-normal">Hello, I'm Dustin!</h1>
    <p class="text-lg">
        A software engineer, nature enjoyer, and overall chill dude.
    </p>
    <div class="flex gap-3 py-3">
        <a href="https://github.com/DustinsCode" aria-label="Github" target="_blank" class="h-5">
            <Github class="h-7 fill-foreground" />
        </a>
        <a href="https://discordapp.com/users/195312689839341569" aria-label="Discord" target="_blank" class="h-5">
            <Discord class="h-7 w-fit fill-foreground" />
        </a>
        <a href="https://www.last.fm/user/dustycode" aria-label="last.fm" target="_blank" class="h-5">
            <LastFM class="h-7 w-fit fill-foreground" />
        </a>
        <a href="https://www.linkedin.com/in/dustycode/" aria-label="LinkedIn" target="_blank" class="h-5">
            <LinkedIn class="h-7 w-fit fill-foreground" />
        </a>
        
    </div>
</div>
