---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/badge.astro";

const jobs = [
  {
    company: "Zenimax Online Studios",
    title: "Senior Applications Engineer",
    notes: [
      "Architected and built web app to bring studio knowledge and communication to one place and automate workflows across different teams with Jira Integration",
      "Worked on web app to search and review both 2D and 3D game assets, with full 3D ",
      "Worked on web app to aggregate in-game market performance and BI data",
      "Managed and automated deployments for web applications and set up hosting infrastrucure",
      "Worked on UX improvement features in desktop application that automates 3D asset pipeline from 3DS Max to game ready assets",
      "Architected and built production tracking web app used for tracking asset production from ideation to game ready 3D asset and iterative feedback with artists through in-app reviews and annotations",
    ],
    techs: [
      "React",
      "Tanstack Start",
      "Remix",
      "TailwindCSS",
      "Fastify",
      "NodeJS",
      "ArangoDB",
      "MySQL",
      "Docker",
      "Typescript",
      "Python",
      "Nginx",
      "Github Actions",
      "BullMQ",
      "RabbitMQ",
      "Redis",
      "Jira/Atlassian API",
    ],
    startYear: "2023",
    endYear: "2026",
  },
  {
    company: "Ford Motor Company",
    title: "Software Engineer Technical Lead",
    notes: [
      "Modernized legacy manufacturing quality software, leading the development effort as the team technical lead",
      "Worked with designers and product managers to plan out features in order to meet deliverable expectations",
    ],
    techs: [
      "Java",
      "Springboot",
      "Angular",
      "MongoDB",
      "RabbitMQ",
      "MQTT",
      "Jenkins",
      "Kubernetes",
    ],
    startYear: "2022",
    endYear: "2023",
  },
  {
    company: "Ford Motor Company",
    title: 'Software Engineer - "Ford College Graduate (FCG)"',
    notes: [
      "Helped automate internal application onboarding into various monitoring tools, like Splunk and Dynatrace in a single self-serve web application",
      "Worked on FordPass Android application, introducing Jetpack Compose to the application",
      "Built various web applications used to train and onboard engineers to company coding standards",
    ],
    techs: [
      "Android",
      "Angular",
      "React",
      "Springboot",
      "Java",
      "Kotlin",
      "Jetpack Compose",
      "ExpressJS",
      "MongoDB",
      "MySQL",
      "Jenkins",
      "Cloud Foundry",
    ],
    startYear: "2019",
    endYear: "2022",
  },
];
---

<Layout title="dustycode - work">
  <div class="flex flex-col gap-3 *:mx-auto">
    <!--#region about me  -->
    <!-- <div class="flex flex-col surface w-full"> -->
    <!--   <h1 class="lg:text-5xl md:text-3xl text-2xl font-semibold mx-auto"> -->
    <!--     About Me -->
    <!--   </h1> -->
    <!--   <p> -->
    <!--     I grew up in Michigan's <a -->
    <!--       class="link" -->
    <!--       href="https://en.wikipedia.org/wiki/Upper_Peninsula_of_Michigan" -->
    <!--       >Upper Peninsula</a -->
    <!--     > -->
    <!--     &nbsp; in the early 2000s. I played tennis throughout highschool, briefly -->
    <!--     participated on the swim team, and played drums and percussion in marching, -->
    <!--     concert, and jazz band. I have since played with a few jazz bands at various -->
    <!--     community colleges near where I have lived. I often went backpacking with -->
    <!--     a High Adventure crew at various places in the UP wilderness. While I spent -->
    <!--     a lot of time playing video games growing up and being pretty introverted, -->
    <!--     I ended up getting my first job at 15 at a small local grocery store, which -->
    <!--     really got me out of my shell. -->
    <!--     <br /><br /> -->
    <!--     By the time I got my first computer, I knew I loved tinkering around and wanted -->
    <!--     to do something with technology for my career. I ended up taking my first -->
    <!--     programming course in 11th grade as well as a pre-engineering & robotics course -->
    <!--     in 12th, where I knew that programming is what I wanted to do. Later on, I -->
    <!--     attended Grand Valley State University where I acquired my bachelor's degree -->
    <!--     in Computer Science and got my first professional job at Ford Motor Company. -->
    <!--     <br /><br /> -->
    <!--     Currently, I am living in the metro Detroit area in Michigan with my partner -->
    <!--     and our cat, Marby. I was recently laid off from Zenimax Online Studios as -->
    <!--     part of Xbox's business restructuring and actively seeking my next role. In -->
    <!--     the meantime, I'm currently enjoying some slow mornings, working on some side -->
    <!--     projects, and taking lots of photos :) -->
    <!--   </p> -->
    <!-- </div> -->
    <div class="flex flex-col surface w-full">
      <h1 class="lg:text-5xl md:text-3xl text-2xl font-semibold mx-auto">
        Stuff I use
      </h1>

      <h2 class="lg:text-2xl text-xl font-semibold">Photography</h2>
      <ul class="list-disc pl-8 text-md">
        <li>Nikon Z5 II</li>
        <li>Nikkor Z 24-50mm Kit Lens</li>
        <li>Tamron AF 200-400mm f/5.6 with Nikon FTZII adapter</li>
        <li><a href="https://www.darktable.org/" class="link">Darktable</a></li>
      </ul>

      <h2 class="lg:text-2xl text-xl font-semibold">Hardware</h2>
      <ul class="list-disc pl-8 text-md">
        <li>2023 Macbook Pro M2</li>
        <li>
          Custom Desktop with i7-9700K, 32GB DDR4, and RTX 2080 Super, Dual
          booted with CachyOS and Windows 11
        </li>
        <li>Keychron K2</li>
        <li>Logitech G502 X</li>
        <li>Focusrite Scarlett 2i2</li>
        <li>Shure SE215 In-Ear Monitors</li>
        <li>Knockoff Shure SM58</li>
        <li>Dual 4K Lenovo ThinkVision Monitors</li>
      </ul>

      <h2 class="lg:text-2xl text-xl font-semibold">Homelab</h2>
      <ul class="list-disc pl-8 text-md">
        <li>Lenovo m920q</li>
        <li>Proxmox VE</li>
        <li><a href="https://tailscale.com/" class="link">Tailscale</a></li>
        <li>Immich (Google Images clone)</li>
        <li>Navidrome (music streaming)</li>
        <li>Umami (website analytics)</li>
      </ul>
    </div>
    <!-- ##endregion -->

    <!-- #region resume -->
    <div class="flex flex-col gap-3 *:mx-auto surface w-full">
      <h1 class="font-semibold lg:text-5xl md:text-3xl text-2xl">Resume</h1>
      <div class="*:mb-3">
        {
          jobs.map((job) => (
            <div>
              <h2 class="text-2xl">{job.title}</h2>
              <div class="text-lg flex gap-2 items-center">
                {job.company}
                <span class="text-gray-0 text-sm">
                  {job.startYear} - {job.endYear}
                </span>
              </div>
              <ul class="list-disc ml-3 [&>li]:mb-2 text-md">
                {job.notes.map((note) => (
                  <li>{note}</li>
                ))}
              </ul>
              <h3>Technologies Used:</h3>
              <div class="flex gap-1 flex-wrap">
                {job.techs.map((tech, idx) => (
                  <Badge
                    style={[
                      idx % 3 === 1
                        ? "bg-orange/20"
                        : idx % 3 === 2
                          ? "bg-blue/20"
                          : "bg-aqua/20",
                    ]}
                  >
                    {tech}
                  </Badge>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <!-- ##endregion -->
  </div>
</Layout>
