---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

function getDisplayDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    timeZone: "UTC",
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}
---

<Layout title="dustycode - blog">
  <div class="gap-4 flex-col md:flex-row mx-auto w-full">
    {
      posts.length === 0 ? (
        <p>No posts yet!</p>
      ) : (
        <ul>
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="surface flex justify-between items-baseline"
              >
                <span>{post.data.title}</span>
                <div class="grow border-b-2 border-dotted mx-2" />
                <span>{getDisplayDate(post.data.pubDate)}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Layout>
