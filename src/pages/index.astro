---
import LastFM from "../components/lastfm.tsx";
import Whoami from "../components/whoami.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="dustycode">
  <div class="flex gap-4 justify-center flex-col md:flex-row">
    <div class="flex-col flex mx-auto w-full gap-3">
      <Whoami />
      <div class="grid grid-cols-3 gap-4">
        <div class="col-span-2">
          <LastFM client:load />
        </div>
      </div>
    </div>
  </div>
</Layout>
