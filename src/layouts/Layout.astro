---
import "../styles/global.css";
import Header from "../components/header.astro";
import CommonHead from "../components/commonHead.astro";
import Footer from "../components/footer.astro";
import Nav from "../components/nav.astro";

const { title } = Astro.props;
---

<html lang="en" class="dark">
  <CommonHead title={title} />
  <body
    class="min-h-screen transition-all duration-200 mx-3 flex flex-col justify-between"
  >
    <div class="">
      <Header />
      <div
        class="grid grid-cols-1 lg:grid-cols-4 auto-rows-auto gap-4 xl:max-w-4xl 2xl:max-w-4xl mx-auto"
      >
        <Nav
          className="lg:row-span-2 lg:col-span-1 hidden lg:block"
          isMobile={false}
        />
        <div class="col-span-3 lg:has-[.pull-up]:-mt-6">
          <slot />
        </div>
      </div>
    </div>
    <div class="self-center">
      <Footer />
    </div>
  </body>
</html>
